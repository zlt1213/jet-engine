---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageUrl } from '../lib/urls';
---
<BaseLayout locale="en" title="Page not found" description="Find your way back to the project notebook." path="404.html" hasCounterpart={false}>
<section class="container page-heading not-found"><p class="eyebrow">404</p><h1>A page out of place.</h1><p>This page could not be found. Return to the project notebook.</p><p><a class="text-link" href={pageUrl('en')}>Project →</a></p><p><a class="text-link" href={pageUrl('zh')} lang="zh-Hans">返回项目首页 →</a></p></section>
</BaseLayout>
