---
import { ui, type Locale } from '../i18n/ui';
import { site } from '../data/site';
import { pageUrl } from '../lib/urls';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<footer class="site-footer container"><div><a class="footer-name" href={pageUrl(locale)}>{t.name}</a><p>{t.footerText}</p></div><nav aria-label={locale === 'zh' ? '页脚链接' : 'Footer links'}><a href={site.github}>{t.github}<span aria-hidden="true">↗</span></a><a href={pageUrl(locale, 'rss.xml')}>{t.rss}<span aria-hidden="true">↗</span></a></nav><span class="footer-credit">© {new Date().getFullYear()} {site.author}</span></footer>
