---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; priority?: boolean; class?: string; }
const { src, alt, caption, priority = false, class: className = '' } = Astro.props;
---
<figure class:list={['figure', className]}>
  {src.format === 'svg' ?
    <img src={src.src} alt={alt} width={src.width} height={src.height} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} /> :
    <Image src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
