---
import type { Locale } from '../i18n/ui';
import { pageUrl } from '../lib/urls';
interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const other = locale === 'en' ? 'zh' : 'en';
---
<a class="language-switch" data-language-switch href={pageUrl(other, path)} lang={other === 'zh' ? 'zh-Hans' : 'en'} hreflang={other === 'zh' ? 'zh-Hans' : 'en'}>
  {other === 'zh' ? '中文' : 'English'}
  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 4h9v9M12 4L3 13" stroke="currentColor" stroke-width="1.3" /></svg>
</a>
