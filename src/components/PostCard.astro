---
import { Image } from 'astro:assets';
import { ui, formatDate, type Locale } from '../i18n/ui';
import { pageUrl } from '../lib/urls';
import type { Post } from '../lib/posts';
interface Props { post: Post; locale: Locale; index?: number; heading?: 'h2' | 'h3'; }
const { post, locale, index = 0, heading: Heading = 'h3' } = Astro.props;
const t = ui[locale];
const url = pageUrl(locale, `build-log/${post.data.translationKey}`);
const image = post.data.heroImage;
---
<article class="post-card" data-post-key={post.data.translationKey} data-post-status={post.data.status}>
  <a class="post-image" href={url} tabindex="-1" aria-hidden="true">
    {image.format === 'svg' ? <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" /> : <Image src={image} alt="" loading="lazy" />}
    <span class="image-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </a>
  <div class="post-copy">
    <div class="post-meta"><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate, locale)}</time>{post.data.status === 'editorial-preview' && <span class="preview-label" data-preview-label>{t.preview}</span>}</div>
    <Heading><a href={url}>{post.data.title}<span class="post-arrow" aria-hidden="true">↗</span></a></Heading>
    <p>{post.data.description}</p>
    <div class="post-tags">{post.data.tags.map((tag) => <a href={pageUrl(locale, `tags/${tag}`)}>{t.tags[tag]}</a>)}</div>
  </div>
</article>
